import("std/list") as list
import("std/rec") as rec
import("std/math") as math
import("./panel_definitions") as panels

export { mean, gene_value, panel_activity, all_panel_activities }

fn mean(xs) {
  list.fold(xs, 0.0, fn(acc, x) { acc + x }) / list.len(xs)
}

fn gene_value(expr_by_gene, gene, sample_id) {
  let row = rec.get(expr_by_gene, gene)
  in rec.get(row, sample_id)
}

fn panel_activity(expr_by_gene, sample_id, panel_name) {
  let panel_map = panels.panel_map_v3()
  in let genes = rec.get(panel_map, panel_name)
  in let vals = list.map(genes, fn(g) { gene_value(expr_by_gene, g, sample_id) })
  in mean(vals)
}

fn all_panel_activities(expr_by_gene, sample_id) {
  let fields = panels.field_order_v3()
  in list.map(fields, fn(panel_name) {
    panel_activity(expr_by_gene, sample_id, panel_name)
  })
}
